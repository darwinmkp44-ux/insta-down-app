<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file.
   Configures data backup rules for Android 12+ (API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
